$ENTRY Go {
    /* empty */ = <TailAll <GetCount>>
}

TailAll {
    0 s.Arg = /* empty */;
    s.Count s.Arg
    , <Arg s.Arg>
    : {
        /* empty */ = /* empty */;
        e.Path = <Prout <Join <Tail s.Count e.Path> '\n'>>
            <TailAll s.Count <+ s.Arg 1>>
    };
}

GetCount {
    /* empty */
    , <Arg 1>
    : {
        '+' e.Number = <Numb e.Number> 2;
        e.Other = 10 1;
    };
}

Tail {
    s.Count e.Name
    , <Last s.Count <GetLines e.Name>>
    : {
        (e.Prefix) e.Suffix = e.Suffix;
    }
}

Join {
    (e.Acc) (e.First) e.Rest s.Separator = <Join
                                        (e.Acc s.Separator e.First)
                                        e.Rest
                                        s.Separator>;
    (e.Acc) s.Separator = e.Acc;
}

FileNo {
    /* empty */ = 10;
}

GetLines {
    e.Name = <Open 'r' <FileNo> e.Name>
    <GetLinesDo>
    <Close <FileNo>>
}

GetLinesDo {
    e.Lines
    , <Get <FileNo>>
    : {
        0 = e.Lines;
        e.Line 0 = e.Lines (e.Line);
        e.Line = <GetLinesDo e.Lines (e.Line)>;
    }
}
