*$FROM LibraryEx
$EXTERN LoadExpr, Map, ArgList;

/* <Go> == empty */
$ENTRY Go {
    /* empty */ = <Main <ArgList>>
}

/* <Main e.ProgName e.FileNames> == empty */
/* e.ProgName ::= (s.CHAR+) */
/* e.FileNames ::= e.FileName* */
/* e.FileName ::= (s.CHAR+) */
Main {
    (e.ProgName) e.FileNames = <Map task2_Process e.FileNames>
}

/* <task2_Process e.FileName> == empty */
/* e.FileName ::= (s.CHAR+) */
$ENTRY task2_Process {
    (e.Filename) = <Prout <RatioPolynoms <LoadExpr e.Filename>>>
}

/* <RatioPolynoms t.Expr> == t.Expr */
/* t.Expr ::= t.Expr '+' t.Expr */
/*     | t.Expr '-' t.Expr */
/*     | t.Expr '*' t.Expr */
/*     | t.Expr '/' t.Expr */
/*     | s.Varname */
/* s.Varname ::= s.WORD */
RatioPolynoms {
    t.Expr
    , <ToRatio t.Expr>
    : {
        (t.Lhs "/" t.Rhs) = (<ToPolynom t.Lhs> "/" <ToPolynom t.Rhs>);
        t.Other = <ToPolynom t.Other>;
    };
}

IsAdditiveExpr {
    (t.Lhs s.Op t.Rhs), "+" "-" : e.1 s.Op e.2
        = True;
    t.Other = False;
}

/* <ToPolynom t.Expr> == t.Expr */
/* t.Expr ::= t.Expr '+' t.Expr */
/*     | t.Expr '-' t.Expr */
/*     | t.Expr '*' t.Expr */
/*     | s.Varname */
/* s.Varname ::= s.WORD */
ToPolynom {
    s.Other = s.Other;
    (t.Lhs "*" t.Rhs)
    , <ToPolynom t.Lhs> <ToPolynom t.Rhs>
    : {
        t.LhsPolynom t.RhsPolynom, <IsAdditiveExpr t.LhsPolynom> <IsAdditiveExpr t.RhsPolynom> : True True
            = <ToPolynom <Multiply t.LhsPolynom t.RhsPolynom>>;
        t.LhsPolynom t.Other, <IsAdditiveExpr t.LhsPolynom> : True
            = <Multiply t.LhsPolynom t.Other>;
        t.Other t.RhsPolynom, <IsAdditiveExpr t.RhsPolynom> : True
            = <Multiply t.RhsPolynom t.Other>;
        t.LhsPolynom t.RhsPolynom = (t.Lhs "*" t.Rhs)
    };
    (t.Lhs s.Op t.Rhs) = (<ToPolynom t.Lhs> s.Op <ToPolynom t.Rhs>);
    t.Other = t.Other;
}

/* <Multiply t.Expr t.Factor> == t.Expr */
/* t.Expr ::= t.Expr '+' t.Expr */
/*     | t.Expr '-' t.Expr */
/*     | t.Expr '*' t.Expr */
/*     | s.Varname */
/* t.Factor ::= t.Expr */
/* s.Varname ::= s.WORD */
Multiply {
    (t.Lhs "*" t.Rhs) t.Factor = (t.Lhs "*" (t.Rhs "*" t.Factor));
    (t.Lhs s.Op t.Rhs) t.Factor = (<Multiply t.Lhs t.Factor> s.Op <Multiply t.Rhs t.Factor>);
    t.Other t.Factor = (t.Other "*" t.Factor)
}

/* <ToRatio t.Expr> == t.Expr */
/* t.Expr ::= t.Expr '+' t.Expr */
/*     | t.Expr '-' t.Expr */
/*     | t.Expr '*' t.Expr */
/*     | t.Expr '/' t.Expr */
/*     | s.Varname */
/* s.Varname ::= s.WORD */
ToRatio {
    s.Other = s.Other;
    (t.Lhs s.Op t.Rhs)
    , (<ToRatio t.Lhs> s.Op <ToRatio t.Rhs>)
    : {
        ((t.A "/" t.B) "/" (t.C "/" t.D)) = ((t.A "*" t.D) "/" (t.C "*" t.B));
        ((t.A "/" t.B) "/" t.C) = (t.A "/" (t.B "*" t.C));
        (t.A "/" (t.B "/" t.C)) = ((t.A "*" t.C) "/" t.B);
        ((t.A "/" t.B) "*" (t.C "/" t.D)) = ((t.A "*" t.C) "/" (t.B "*" t.D));
        ((t.A "/" t.B) "*" t.C) = ((t.A "*" t.C) "/" t.B);
        (t.A "*" (t.B "/" t.C)) = ((t.A "*" t.B) "/" t.C);
        ((t.A "/" t.B) s.PlusOrMinus (t.C "/" t.D)) = (((t.A "*" t.D) s.PlusOrMinus (t.C "*" t.B)) "/" (t.B "*" t.D));
        ((t.A "/" t.B) s.PlusOrMinus t.C) = ((t.A s.PlusOrMinus (t.C "*" t.B)) "/" t.B);
        (t.A s.PlusOrMinus (t.B "/" t.C)) = (((t.A "*" t.C) s.PlusOrMinus t.B) "/" t.C);
        t.Other = t.Other;
    }
}
